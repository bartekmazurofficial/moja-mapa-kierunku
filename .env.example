# ---------------------------------------------------------------------------
# LOKALNIE
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# Jedno konto prowadzacego. Haslo wylacznie ze zmiennej srodowiskowej,
# bez tabeli uzytkownikow.
PROWADZACY_HASLO="zmien-to-przed-pilotazem"

# Sekret do podpisywania ciasteczka sesji prowadzacego (min. 32 znaki).
SESJA_SEKRET="zmien-to-na-losowy-ciag-minimum-32-znaki"

# Tylko do testow: pokazuje liste uczestnikow na ekranie wejscia, zeby dalo sie
# wejsc bez kodu. NIGDY na produkcji — publiczna lista uczestnikow lamie zasade,
# ze nie da sie wyliczyc, kto jest w programie.
# TRYB_TESTOWY=1

# ---------------------------------------------------------------------------
# WDROZENIE: Vercel + Supabase
# ---------------------------------------------------------------------------
# Te dwa adresy sa w Supabase w Project Settings / Database / Connection string.
#
# DATABASE_URL to pula polaczen (Transaction pooler, port 6543). Aplikacja
# bezserwerowa otwiera polaczenie przy kazdym zadaniu, wiec bez puli wyczerpie
# limit Supabase przy kilkunastu osobach naraz.
#
# DIRECT_URL to polaczenie bezposrednie (port 5432). Sluzy wylacznie do
# `prisma db push`: pula nie obsluguje polecen zmieniajacych schemat.
#
# DATABASE_URL="postgresql://postgres.PROJEKT:HASLO@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.PROJEKT:HASLO@aws-0-REGION.pooler.supabase.com:5432/postgres"
