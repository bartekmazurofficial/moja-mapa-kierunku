DATABASE_URL="file:./dev.db"
# Jedno konto prowadzacego. Haslo wylacznie ze zmiennej srodowiskowej, bez tabeli uzytkownikow.
PROWADZACY_HASLO="zmien-to-przed-pilotazem"
# Sekret do podpisywania ciasteczka sesji prowadzacego (min. 32 znaki).
SESJA_SEKRET="zmien-to-na-losowy-ciag-minimum-32-znaki"
# Tylko do testów: pokazuje listę uczestników na ekranie wejścia, żeby dało się
# wejść bez kodu. NIGDY na produkcji — publiczna lista uczestników łamie zasadę,
# że nie da się wyliczyć, kto jest w programie.
# TRYB_TESTOWY=1
